{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-BCP36BJ\\NEWSQLSERVER0318;Database=Day19DB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Information"
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],

    "Enrich": [
      "FromLogContext"
    ]
  },

  "AllowedHosts": "*"
}